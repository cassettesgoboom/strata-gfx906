{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cassettesgoboom/strata-gfx906/blob/main/benchmarks/gfx906/build-receipt-v1.schema.json",
  "title": "Strata gfx906 build receipt, version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "source", "target", "toolchain", "build", "artifact"],
  "properties": {
    "schema_version": {"const": 1},
    "receipt_id": {"type": "string", "minLength": 1},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "commit", "dirty"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[0-9a-fA-F]{7,64}$"},
        "dirty": {"type": "boolean"},
        "patch_bundle_ref": {"type": "string", "minLength": 1},
        "patch_bundle_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
      },
      "allOf": [
        {
          "if": {"properties": {"dirty": {"const": true}}, "required": ["dirty"]},
          "then": {"required": ["patch_bundle_ref", "patch_bundle_sha256"]}
        }
      ]
    },
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["architecture"],
      "properties": {"architecture": {"const": "gfx906"}}
    },
    "toolchain": {
      "type": "object", "additionalProperties": false,
      "required": ["compiler", "compiler_version", "rocm_version"],
      "properties": {
        "compiler": {"type": "string", "minLength": 1},
        "compiler_version": {"type": "string", "minLength": 1},
        "rocm_version": {"type": "string", "minLength": 1},
        "components": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["name", "version"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1},
              "revision": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "build": {
      "type": "object", "additionalProperties": false,
      "required": ["system", "generator", "configuration", "options", "command", "exit_code"],
      "properties": {
        "system": {"type": "string", "minLength": 1},
        "generator": {"type": "string", "minLength": 1},
        "configuration": {"type": "string", "minLength": 1},
        "options": {"type": "object"},
        "command": {"type": "string", "minLength": 1},
        "exit_code": {"type": "integer"},
        "log_ref": {"type": "string", "minLength": 1}
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    }
  }
}
